# ThumbBot Configuration
# Copy this file to .env and configure the values

# ===========================================
# REQUIRED
# ===========================================

# Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# ===========================================
# OPTIONAL
# ===========================================

# Cobalt API URL (default: http://thumbbot-cobalt:9000)
# COBALT_URL=http://thumbbot-cobalt:9000

# Preferred video quality - will fallback to lower if file too big
# Options: max, 4k, 1440p, 1080p, 720p, 480p, 360p, 240p, 144p
# PREFERRED_QUALITY=max

# Maximum file size in MB (default: 8, Discord's free tier limit)
# Files larger than this will trigger quality fallback
# MAX_FILE_SIZE_MB=8

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# How to handle multiple files from a single link
# Options: first, last, all (default: all)
# PICKER_BEHAVIOR=all

# Maximum concurrent downloads (default: 10)
# MAX_CONCURRENT_DOWNLOADS=10

# Download timeout in seconds (default: 120)
# DOWNLOAD_TIMEOUT=120

# Auto-cleanup downloaded files after upload (default: true)
# AUTO_CLEANUP=true

# Temporary directory for downloads (default: ./temp_videos)
# TEMP_DIR=./temp_videos

# Prometheus metrics port (default: 8002)
# METRICS_PORT=8002

# Path to providers config file (default: providers.yaml)
# PROVIDERS_FILE=providers.yaml

# ===========================================
# TRACING (OpenTelemetry)
# ===========================================

# OTEL endpoint for traces (leave empty to disable tracing)
# Local testing with Jaeger: http://jaeger:4317
# Production with your OTEL collector: http://otel-collector:4317
# OTEL_ENDPOINT=

# Enable/disable tracing (default: true, but requires OTEL_ENDPOINT)
# OTEL_ENABLED=true
